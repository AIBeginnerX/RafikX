{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RafikX",
  "version": "0.3.4",
  "identifier": "dev.rafikx.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RafikX",
        "label": "main",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#03060e"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Personal AI coding agent",
    "longDescription": "RafikX desktop ??the same classify ??bind ??pack ??tools ??verify harness as the CLI, in a lightweight window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
